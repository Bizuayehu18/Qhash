{
  "name": "saas",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "22.23.1",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "clean": "rimraf dist .tanstack/tmp",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:dependencies": "node scripts/check-dependency-lock.mjs",
    "test:portable": "node scripts/run-tests.mjs portable",
    "test:native": "node scripts/run-tests.mjs native",
    "test:handlers": "node scripts/run-tests.mjs handlers",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:netlify": "tsc --noEmit --project tsconfig.netlify.json",
    "generate:routes": "node scripts/generate-route-tree.mjs",
    "check:routes-generated": "node scripts/check-route-tree.mjs",
    "check:database-types": "node scripts/check-database-types.mjs",
    "update:database-types-baseline": "node scripts/update-database-types-baseline.mjs",
    "check:boundaries": "node scripts/check-engineering-baseline.mjs boundaries",
    "check:complexity": "node scripts/check-engineering-baseline.mjs complexity",
    "check:docs": "node scripts/check-engineering-baseline.mjs docs",
    "verify": "npm run check:toolchain && npm run check:dependencies && npm run test:portable && npm run test:handlers && npm run typecheck && npm run typecheck:netlify && npm run check:routes-generated && npm run check:database-types && npm run check:boundaries && npm run check:complexity && npm run check:docs && npm run build",
    "verify:native": "npm run check:toolchain && npm run test:native",
    "prebuild": "rimraf dist .tanstack/tmp && npm run typecheck && npm run typecheck:netlify && npm run check:routes-generated",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "build": "vite build"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.1",
    "@supabase/supabase-js": "^2.47.0",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-start": "1.167.41",
    "@tanstack/react-store": "0.10.0",
    "@tanstack/router-plugin": "1.167.22",
    "@tanstack/store": "0.10.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "lucide-react": "^0.576.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.0",
    "unpdf": "^1.6.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@netlify/vite-plugin-tanstack-start": "1.3.7",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/router-generator": "1.166.32",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^1.0.0-beta.22",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.6",
    "tsx": "4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7"
  }
}
